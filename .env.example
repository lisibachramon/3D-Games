# Copy to .env and fill in. Used by docker-compose.yml.

# Email for Let's Encrypt cert registration (required).
LETSENCRYPT_EMAIL=you@example.com

# Public hostname for FLOTSAM (DNS A record -> this host).
FLOTSAM_VHOST=flotsam.lisibach.xyz

# Public hostname for PULSAR (DNS A record -> this host).
PULSAR_VHOST=pulsar.lisibach.xyz

# Local-dev published ports (host:container). Ignored by the reverse proxy.
FLOTSAM_PORT=8080
PULSAR_PORT=8081

# Run containers as this uid:gid (defaults to root, matching the reference).
PUID=0
PGID=0
